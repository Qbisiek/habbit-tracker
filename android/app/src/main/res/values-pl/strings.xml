    <!--
        A value with its unit (UI-DAY-VALUE), as ICU MessageFormat patterns: {0} is the value, {1} the label of a
        custom unit. The plural form is chosen for the decimal value as it is shown ("0,5 szklanki"), which Android
        plurals cannot do, since they choose by an integer.
    -->
    <string name="unit_value_ml">{0,number} ml</string>
    <string name="unit_value_l">{0,number} l</string>
    <string name="unit_value_glasses">{0,plural, one{# szklanka} few{# szklanki} many{# szklanek} other{# szklanki}}</string>
    <string name="unit_value_g">{0,number} g</string>
    <string name="unit_value_kg">{0,number} kg</string>
    <string name="unit_value_km">{0,number} km</string>
    <string name="unit_value_steps">{0,plural, one{# krok} few{# kroki} many{# kroków} other{# kroku}}</string>
    <string name="unit_value_kcal">{0,number} kcal</string>
    <string name="unit_value_pages">{0,plural, one{# strona} few{# strony} many{# stron} other{# strony}}</string>
    <string name="unit_value_repetitions">{0,plural, one{# powtórzenie} few{# powtórzenia} many{# powtórzeń} other{# powtórzenia}}</string>
    <string name="unit_value_count">{0,plural, one{# raz} few{# razy} many{# razy} other{# raza}}</string>
    <string name="unit_value_custom">{0,number} {1}</string>
