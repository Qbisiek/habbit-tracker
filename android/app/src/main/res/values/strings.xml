    <string name="unit_value_pages">{0,plural, one{# page} other{# pages}}</string>
    <string name="unit_value_repetitions">{0,plural, one{# repetition} other{# repetitions}}</string>
    <string name="unit_value_count">{0,plural, one{# time} other{# times}}</string>
