    <!--
        A value with its unit (UI-DAY-VALUE), as ICU MessageFormat patterns: {0} is the value, {1} the label of a
        custom unit. The plural form is chosen for the decimal value as it is shown ("0,5 szklanki"), which Android
        plurals cannot do, since they choose by an integer.
    -->
    <string name="unit_value_ml">{0,number} ml</string>
    <string name="unit_value_l">{0,number} l</string>
    <string name="unit_value_glasses">{0,plural, one{# glass} other{# glasses}}</string>
    <string name="unit_value_g">{0,number} g</string>
    <string name="unit_value_kg">{0,number} kg</string>
    <string name="unit_value_km">{0,number} km</string>
